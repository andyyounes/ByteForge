{
  "name": "byteforge",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "verify": "node scripts/check-lesson-js.mjs && node scripts/test-g6-maze.mjs && node scripts/test-g7-challenges.mjs && node scripts/test-g8-challenges.mjs && node scripts/test-g9-missions.mjs && node scripts/test-g9-challenges.mjs && node scripts/test-igcse-y1-challenges.mjs && node scripts/test-igcse-y2-challenges.mjs && node scripts/test-al-lab.mjs && node scripts/test-p4-challenges.mjs && node scripts/test-p4-starters.mjs && node scripts/test-al-practice.mjs && node scripts/test-cpu-pipeline.mjs && node scripts/test-as-pseudo.mjs && node scripts/test-as-sql.mjs && node scripts/test-theory-scoring.mjs && node scripts/test-tool-lessons.mjs && node scripts/test-algo-viz.mjs && node scripts/test-interpreters.mjs && node scripts/test-chest-rewards.mjs",
    "test": "node scripts/test-all.mjs",
    "test:list": "node scripts/test-all.mjs --list",
    "test:ui": "node scripts/test-ui-render.mjs",
    "test:all": "node scripts/test-all.mjs --browser",
    "verify:g6-worlds": "node scripts/test-g6-worlds.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/pdf-parse": "^1.1.5",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.11",
    "framer-motion": "^11.3.31",
    "groq-sdk": "^0.9.0",
    "next": "^15.5.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.byteforge.app",
    "productName": "ByteForge",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "andyyounes",
      "repo": "ByteForge"
    }
  }
}
