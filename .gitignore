# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
# ...except electron-builder's icon source (its own "buildResources"
# convention, same folder name by coincidence) — that one file needs to
# actually be committed for the desktop app's icon. (/build/* + a
# negation, not /build + a negation — git can't un-ignore a path inside
# a directory that's ignored as a whole.)
/build/*
!/build/icon.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Teacher LaTeX decks — kept locally, not deployed (not needed by the app, was bloating the repo)
latex/

# Printable teacher worksheets — kept locally only, not part of the deployed app
worksheets/
dist-electron/
